# OpenERP API environment — copy to `apps/api/.env` for local dev.

# Postgres connection used by migrate, seed:dev and the dev server.
# Matches docker-compose.yml (postgres service publishes 127.0.0.1:5432).
OPENERP_DATABASE_URL=postgresql://openerp:openerp@127.0.0.1:5432/openerp

# Optional override; defaults to 4000.
OPENERP_API_PORT=4000

# Local WebAuthn/passkey dev defaults. The RP ID defaults to the hostname from
# OPENERP_WEB_ORIGIN. Override both together if using localhost instead of
# 127.0.0.1.
OPENERP_WEB_ORIGIN=http://127.0.0.1:4173
OPENERP_WEBAUTHN_RP_ID=127.0.0.1

# Optional session secret for dev JWTs minted after passkey login. The dev
# server has a local fallback; set this when you need stable tokens across
# restarts.
OPENERP_SESSION_SECRET=

# Integration test target. Set ONLY when running pg-smoke locally:
#   docker compose up -d postgres
#   OPENERP_INTEGRATION_DATABASE_URL=postgresql://openerp:openerp@127.0.0.1:5432/openerp \
#     npm test -w @sentropic/openerp-api -- pg-smoke
OPENERP_INTEGRATION_DATABASE_URL=
