# SvelteKit web environment — copy to `apps/web/.env` and tailor.

# Base URL of the OpenERP API. The SSR loaders use this for server-side
# fetches; the browser never talks to the API directly in MVP.
OPENERP_API_URL=http://127.0.0.1:4000

# Dev tenant context. Set both to the IDs printed by
#   npm run seed:dev -w @sentropic/openerp-api
# When either is unset, SSR loaders fall back to the static demo data so the
# UI is still browsable in unconfigured dev / Playwright e2e runs.
OPENERP_DEV_ORG_ID=
OPENERP_DEV_USER_ID=
