# Keep the build context lean and force a clean in-image build.
**/node_modules
node_modules
.git
**/dist
**/build
**/.svelte-kit
tmp
.remote
research
docs
*.log

# Never ship a local environment file. These are gitignored, so a CI build from
# a clean checkout has none and the published images are unaffected. A local
# `docker build` is the hole: it would bake the developer's own .env — cluster
# kubeconfig and session passwords included — into an image whose registry
# package is now PUBLIC. The committed .env.example templates stay.
**/.env
**/.env.*
# Re-included by exact path, not by a `!**/.env.example` glob: a global
# negation outranks the `research` exclusion above and would drag vendored
# third-party templates back into the build context.
!apps/api/.env.example
!apps/web/.env.example

# Local agent working directories. Not gitignored everywhere, no business in an
# image, and they can hold session material.
.h2a
.graphify
