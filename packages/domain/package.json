{
  "name": "@sentropic/openerp-domain",
  "version": "0.1.0",
  "description": "OpenERP domain canon entities and abstraction contracts (shared types for the @sentropic/openerp-* workspace)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhanka/openerp.git",
    "directory": "packages/domain"
  },
  "type": "module",
  "main": "./dist/foundation.js",
  "types": "./dist/foundation.d.ts",
  "exports": {
    ".": {
      "types": "./dist/foundation.d.ts",
      "default": "./dist/foundation.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "default": "./dist/contracts.js"
    },
    "./crm": {
      "types": "./dist/crm.d.ts",
      "default": "./dist/crm.js"
    },
    "./project": {
      "types": "./dist/project.d.ts",
      "default": "./dist/project.js"
    },
    "./billing": {
      "types": "./dist/billing.d.ts",
      "default": "./dist/billing.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "docs": "typedoc",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typedoc": "^0.27.9"
  }
}
