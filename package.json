{
  "name": "openerp",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:workspace": "node scripts/check-workspace.mjs",
    "check:i18n": "node scripts/validate-i18n.mjs",
    "check:anti-copy": "bash tools/anti-copy-grep.sh",
    "check:ingress": "node tools/check-ingress-shadowing.mjs",
    "check:foundation": "npm run check:workspace && npm run check:i18n && npm run check:anti-copy && npm run lint && npm test && npm run build",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "cookie": "^0.7.2",
    "brace-expansion": "^2.1.2",
    "dompurify": "^3.4.13",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.4",
    "vite": "^6.4.3",
    "linkify-it": "^5.0.2",
    "markdown-it": "^14.3.0",
    "postcss": "^8.5.18",
    "@modelcontextprotocol/sdk@1.29.0": {
      "@hono/node-server": "^2.0.5"
    }
  }
}
